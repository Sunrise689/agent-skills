{
  "name": "mineru-parser",
  "version": "1.0.0",
  "description": "MinerU 文档智能解析技能 - 调用云端 API 将 PDF/Word/PPT/Excel/图片转为结构化 Markdown/JSON/HTML",
  "main": "scripts/parse.js",
  "bin": {
    "mineru-parse": "scripts/parse.js"
  },
  "scripts": {
    "test": "node scripts/parse.js --help",
    "install-deps": "npm install mineru-open-sdk commander"
  },
  "keywords": [
    "mineru",
    "document-parsing",
    "pdf-to-markdown",
    "ocr",
    "table-extraction",
    "formula-recognition",
    "rag"
  ],
  "author": "OpenDataLab (上海AI实验室)",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opendatalab/MinerU"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "mineru-open-sdk": "^0.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
